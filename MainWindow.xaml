<Window x:Class="AndroidLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Log Viewer"
        Width="1220"
        Height="760"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FC"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <Style x:Key="InlineLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource InlineLabel}" Text="设备" />
            <ComboBox x:Name="deviceCombo"
                      Grid.Row="0"
                      Grid.Column="1"
                      Background="Black"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="DeviceCombo_SelectionChanged"
                      Text="xxxxxxxxxxxx"/>
            <Button x:Name="refreshDevicesButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Click="RefreshDevicesButton_Click"
                    Content="刷新设备" />

            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button x:Name="startLogButton" Click="StartLogButton_Click" Content="开始日志" />
                <CheckBox x:Name="clearBeforeStartCheckBox"
                          Margin="0,6,12,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="开始前清空" />
                <Button x:Name="stopLogButton" Click="StopLogButton_Click" Content="停止" IsEnabled="False" />
                <Button Click="ClearDeviceLogButton_Click" Content="清空设备日志" />
                <Button Click="ClearViewButton_Click" Content="清空显示" />
                <Button Margin="0,0,0,0" Click="AboutButton_Click" Content="About" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="Bold" Text="安装 APK" />
                    <Border x:Name="dropPanel"
                            Grid.Row="1"
                            AllowDrop="True"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            DragEnter="DropPanel_DragEnter"
                            Drop="DropPanel_Drop">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Text="拖入 APK 安装" />
                    </Border>

                    <TextBlock Grid.Row="2" Margin="0,18,0,8" FontWeight="Bold" Text="卸载包名" />
                    <ComboBox x:Name="packageComboBox"
                              Grid.Row="3"
                              Margin="0,0,0,8"
                              IsEditable="True"
                              IsTextSearchEnabled="True" />
                    <Button x:Name="uninstallButton"
                            Grid.Row="4"
                            Margin="0"
                            Click="UninstallButton_Click"
                            Content="卸载" />
                    <TextBlock Grid.Row="5"
                               Margin="0,18,0,0"
                               Foreground="#5A606A"
                               TextWrapping="Wrap"
                               Text="说明：&#x0a;1. 选择设备后，把 APK 拖到上方区域安装。&#x0a;2. 拖入 APK 会自动读取包名并填入卸载框。&#x0a;3. 下拉框只列出第三方用户应用。" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource InlineLabel}" Text="文本" />
                            <TextBox x:Name="searchTextBox" Width="260" Margin="0,0,18,0" TextChanged="FilterTextChanged" />
                            <TextBlock Style="{StaticResource InlineLabel}" Text="Tag" />
                            <TextBox x:Name="tagTextBox" Width="220" Margin="0,0,18,0" TextChanged="FilterTextChanged" />
                            <TextBlock Style="{StaticResource InlineLabel}" Text="级别" />
                            <ComboBox x:Name="levelCombo" Width="86" Margin="0,0,18,0" SelectionChanged="FilterSelectionChanged">
                                <ComboBoxItem Content="All" IsSelected="True" />
                                <ComboBoxItem Content="V" />
                                <ComboBoxItem Content="D" />
                                <ComboBoxItem Content="I" />
                                <ComboBoxItem Content="W" />
                                <ComboBoxItem Content="E" />
                                <ComboBoxItem Content="F" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource InlineLabel}" Text="定位" />
                            <TextBox x:Name="locateTextBox" Width="210" Margin="0,0,8,0" TextChanged="LocateTextChanged" KeyDown="LocateTextBox_KeyDown" />
                            <Button Margin="0" Click="LocateNextButton_Click" Content="下一个" />
                        </WrapPanel>

                        <WrapPanel>
                            <CheckBox x:Name="captureCrashCheckBox"
                                      Margin="0,6,12,0"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Content="捕获崩溃" />
                            <Button Click="SaveCrashButton_Click" Content="保存崩溃" />
                            <Button Click="ClearCrashButton_Click" Content="清空崩溃" />
                            <Button Click="SaveAllLogsButton_Click" Content="保存日志" />
                            <TextBlock Margin="6,0,8,0" Style="{StaticResource InlineLabel}" Text="存储" />
                            <ComboBox x:Name="storeLevelCombo" Width="86" Margin="0,0,14,0">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="W" IsSelected="True" />
                                <ComboBoxItem Content="E" />
                                <ComboBoxItem Content="All" />
                            </ComboBox>
                            <Button Margin="0" Click="AnalyzeFileButton_Click" Content="分析文件" />
                        </WrapPanel>
                    </StackPanel>

                    <TabControl Grid.Row="1">
                        <TabItem Header="日志">
                            <DataGrid x:Name="logGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableRowVirtualization="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      LoadingRow="LogGrid_LoadingRow"
                                      SelectionChanged="LogGrid_SelectionChanged"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="120" Binding="{Binding Time}" Header="时间" />
                                    <DataGridTextColumn Width="54" Binding="{Binding Level}" Header="级别" />
                                    <DataGridTextColumn Width="180" Binding="{Binding Tag}" Header="Tag" />
                                    <DataGridTextColumn Width="70" Binding="{Binding ProcessId}" Header="PID" />
                                    <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="内容" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="崩溃信息">
                            <TextBox x:Name="crashTextBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="statusLabel"
                   Grid.Row="2"
                   Height="28"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
