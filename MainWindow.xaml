<Window x:Class="AndroidLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Android Log Viewer"
        Width="1220"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="0,0,0,8"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="DeviceLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="设备" />
            <ComboBox x:Name="DeviceComboBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="DeviceComboBox_SelectionChanged">
                <ComboBox.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="White" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="White" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                </ComboBox.Resources>
            </ComboBox>
            <Button x:Name="RefreshDevicesButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Click="RefreshDevicesButton_Click"
                    Content="刷新设备" />

            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Button x:Name="StartLogButton" Click="StartLogButton_Click" Content="开始日志" />
                <CheckBox x:Name="ClearBeforeStartCheckBox"
                          Margin="0,5,12,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="开始前清空" />
                <Button x:Name="StopLogButton" Click="StopLogButton_Click" Content="停止" IsEnabled="False" />
                <Button x:Name="ClearDeviceLogButton" Click="ClearDeviceLogButton_Click" Content="清空设备日志" />
                <Button x:Name="ClearViewButton" Click="ClearViewButton_Click" Content="清空显示" />
                <Button x:Name="UserGuideButton" Click="UserGuideButton_Click" Content="使用说明" />
                <Button x:Name="AdbShellButton" Click="AdbShellButton_Click" Content="ADB 命令行" />
                <Button x:Name="AaptShellButton" Click="AaptShellButton_Click" Content="AAPT 命令行" />
                <Button x:Name="CommonCommandsButton" Click="CommonCommandsButton_Click" Content="常用指令" />
                <Button x:Name="AboutButton" Click="AboutButton_Click" Content="About" />
                <TextBlock x:Name="LanguageLabel" Margin="12,0,8,0" Style="{StaticResource LabelText}" Text="语言" />
                <ComboBox x:Name="LanguageComboBox"
                          Width="104"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="中文" Tag="zh-CN" IsSelected="True" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                </ComboBox>
            </WrapPanel>
        </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="InstallApkLabel" Grid.Row="0" Margin="0,0,0,8" FontWeight="Bold" Text="安装 APK" />
                    <Border x:Name="ApkDropBox"
                            Grid.Row="1"
                            AllowDrop="True"
                            Background="#F8FAFD"
                            BorderBrush="#C9D3E1"
                            BorderThickness="1"
                            DragEnter="ApkDropBox_DragEnter"
                            Drop="ApkDropBox_Drop">
                        <TextBlock x:Name="DropApkLabel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#334155"
                                   Text="拖入 APK 安装" />
                    </Border>

                    <TextBlock x:Name="PackageNameLabel" Grid.Row="2" Margin="0,18,0,8" FontWeight="Bold" Text="卸载包名" />
                    <ComboBox x:Name="PackageComboBox"
                              Grid.Row="3"
                              Margin="0,0,0,8"
                              IsEditable="True"
                              IsTextSearchEnabled="True" />
                    <Button x:Name="UninstallButton"
                            Grid.Row="4"
                            Margin="0"
                            Click="UninstallButton_Click"
                            Content="卸载" />
                    <Border Grid.Row="5"
                            Margin="0,18,0,0"
                            Padding="10"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ApkInfoTitleLabel" FontWeight="Bold" Text="APK 信息" />
                                <TextBlock x:Name="InstructionsTextBlock"
                                           Margin="0,8,0,0"
                                           Foreground="#475569"
                                           TextWrapping="Wrap"
                                           Text="拖入 APK 后显示应用信息。" />
                                <Grid x:Name="ApkInfoGrid" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ApkAppLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" Foreground="#475569" Text="应用" />
                                    <TextBlock x:Name="ApkAppTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ApkVersionLabel" Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" Foreground="#475569" Text="版本" />
                                    <TextBlock x:Name="ApkVersionTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ApkVersionCodeLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" Foreground="#475569" Text="版本号" />
                                    <TextBlock x:Name="ApkVersionCodeTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <Button x:Name="ApkDetailsButton"
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="0"
                                            Click="ApkDetailsButton_Click"
                                            Content="详情" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="10"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" MinWidth="180" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TextFilterLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="文本" />
                            <TextBox x:Name="TextFilterTextBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     TextChanged="FilterChanged" />

                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource LabelText}" Text="Tag" />
                            <TextBox x:Name="TagFilterTextBox"
                                     Grid.Row="0"
                                     Grid.Column="4"
                                     TextChanged="FilterChanged" />

                            <TextBlock x:Name="LevelLabel" Grid.Row="0" Grid.Column="6" Style="{StaticResource LabelText}" Text="级别" />
                            <ComboBox x:Name="LevelComboBox"
                                      Grid.Row="0"
                                      Grid.Column="7"
                                      SelectionChanged="FilterSelectionChanged">
                                <ComboBoxItem Content="All" IsSelected="True" />
                                <ComboBoxItem Content="V" />
                                <ComboBoxItem Content="D" />
                                <ComboBoxItem Content="I" />
                                <ComboBoxItem Content="W" />
                                <ComboBoxItem Content="E" />
                                <ComboBoxItem Content="F" />
                            </ComboBox>

                            <TextBlock x:Name="LocateLabel" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelText}" Text="定位" />
                            <TextBox x:Name="LocateTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     KeyDown="LocateTextBox_KeyDown"
                                     TextChanged="LocateTextBox_TextChanged" />
                            <Button x:Name="LocateNextButton"
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Margin="0"
                                    Click="LocateNextButton_Click"
                                    Content="下一个" />

                            <TextBlock x:Name="StorageLabel" Grid.Row="2" Grid.Column="6" Style="{StaticResource LabelText}" Text="存储" />
                            <ComboBox x:Name="StoreLevelComboBox"
                                      Grid.Row="2"
                                      Grid.Column="7">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="W" IsSelected="True" />
                                <ComboBoxItem Content="E" />
                                <ComboBoxItem Content="All" />
                            </ComboBox>
                            <Button x:Name="AnalyzeFileButton"
                                    Grid.Row="2"
                                    Grid.Column="9"
                                    Click="AnalyzeFileButton_Click"
                                    Content="分析文件" />

                            <StackPanel Grid.Row="4"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="12"
                                        Orientation="Horizontal">
                                <CheckBox x:Name="CaptureCrashCheckBox"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Content="捕获崩溃" />
                                <Button x:Name="SaveCrashButton" Click="SaveCrashButton_Click" Content="保存崩溃" />
                                <Button x:Name="ClearCrashButton" Click="ClearCrashButton_Click" Content="清空崩溃" />
                                <Button x:Name="SaveLogsButton" Click="SaveLogsButton_Click" Content="保存日志" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1">
                        <TabItem x:Name="LogTabItem" Header="日志">
                            <DataGrid x:Name="LogDataGrid"
                                      AutoGenerateColumns="False"
                                      Background="White"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      EnableColumnVirtualization="True"
                                      EnableRowVirtualization="True"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      RowBackground="White"
                                      AlternatingRowBackground="White"
                                      LoadingRow="LogDataGrid_LoadingRow"
                                      ScrollViewer.ScrollChanged="LogDataGrid_ScrollChanged"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="TimeColumn" Width="120" Binding="{Binding Time}" Header="时间" />
                                    <DataGridTextColumn x:Name="LevelColumn" Width="54" Binding="{Binding Level}" Header="级别" />
                                    <DataGridTextColumn Width="180" Binding="{Binding Tag}" Header="Tag" />
                                    <DataGridTextColumn Width="70" Binding="{Binding ProcessId}" Header="PID" />
                                    <DataGridTextColumn x:Name="ContentColumn" Width="*" Binding="{Binding Message}" Header="内容" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="CrashTabItem" Header="崩溃信息">
                            <TextBox x:Name="CrashTextBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Foreground="#DC2626"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2"
                Margin="0,10,0,0"
                Background="#F8FAFC">
       
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="0"
                       Grid.Column="0"
                   Text="xxx"
                   FontSize="14"
                   VerticalAlignment="Center"></TextBlock>
            <TextBlock x:Name="TextInfoBlock"
                       Grid.Row="0"
                       Grid.Column="1"
                   Text="祈福没bug,没崩溃!不加班。"
                   FontSize="14"
                       Foreground="#66000000"
                       HorizontalAlignment="Center"
                   VerticalAlignment="Center"></TextBlock>

        </Grid>
    </Grid>
</Window>
